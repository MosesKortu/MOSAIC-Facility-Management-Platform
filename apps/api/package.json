{
  "name": "@mosaic/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env src/db/cli.ts up",
    "db:rollback": "node --env-file-if-exists=.env src/db/cli.ts down",
    "schema:doc": "node src/db/cli.ts doc",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-dev.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.2",
    "@mosaic/contracts": "workspace:*",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
