# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=3100
DATABASE_URL=postgres://mosaic:mosaic@localhost:54329/mosaic
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Dev-only login (09_ARCHITECTURE.md D6). Refused at startup when NODE_ENV=production.
AUTH_DEV_LOGIN=true
WEB_ORIGIN=http://localhost:5173
